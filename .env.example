# Copy to .env.local and fill in. Never commit real secrets.

# Public URL of the site (used for SEO: canonical links, sitemap, share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: the app works end to end without a backend and accepts any code.
# ⚠️ Set to false before launch (see src/config/demoMode.ts).
NEXT_PUBLIC_DEMO_MODE=true
